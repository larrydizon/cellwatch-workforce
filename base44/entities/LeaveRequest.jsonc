{
  "name": "LeaveRequest",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this leave request belongs to"
    },
    "employee_email": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "annual",
        "sick",
        "bereavement",
        "unpaid",
        "other"
      ],
      "default": "annual"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "days_requested": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes from admin when approving or declining"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of admin who reviewed"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "employee_email",
    "leave_type",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "$or": [
          { "data.employee_email": "{{user.email}}" },
          { "user_condition": { "role": "admin" } },
          { "user_condition": { "role": "operations_manager" } },
          { "user_condition": { "role": "supervisor" } }
        ] }
      ]
    },
    "create": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "data.employee_email": "{{user.email}}" }
      ]
    },
    "update": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "$or": [
          { "user_condition": { "role": "admin" } },
          { "user_condition": { "role": "operations_manager" } },
          { "user_condition": { "role": "supervisor" } }
        ] }
      ]
    },
    "delete": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
