{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this time entry belongs to"
    },
    "employee_email": {
      "type": "string",
      "description": "Email of the employee"
    },
    "employee_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string",
      "description": "Associated job ID"
    },
    "job_title": {
      "type": "string"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time",
      "description": "Clock in timestamp"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time",
      "description": "Clock out timestamp"
    },
    "clock_in_lat": {
      "type": "number"
    },
    "clock_in_lng": {
      "type": "number"
    },
    "clock_out_lat": {
      "type": "number"
    },
    "clock_out_lng": {
      "type": "number"
    },
    "break_start": {
      "type": "string",
      "format": "date-time"
    },
    "break_end": {
      "type": "string",
      "format": "date-time"
    },
    "total_hours": {
      "type": "number"
    },
    "break_minutes": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "pending_approval",
        "approved",
        "rejected",
        "adjustment_requested"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "is_overtime": {
      "type": "boolean",
      "default": false
    },
    "overtime_hours": {
      "type": "number",
      "default": 0,
      "description": "Extra hours the employee agreed to work before auto clock-out"
    },
    "overtime_decision": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "Employee answer to the shift-limit overtime reminder"
    }
  },
  "required": [
    "employee_email",
    "clock_in",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        {
          "$or": [
            { "data.employee_email": "{{user.email}}" },
            { "user_condition": { "role": "admin" } },
            { "user_condition": { "role": "operations_manager" } },
            { "user_condition": { "role": "supervisor" } }
          ]
        }
      ]
    },
    "create": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
