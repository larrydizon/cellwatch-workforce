{
  "name": "Training",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this training record belongs to"
    },
    "employee_email": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "Certificate / training / ticket name"
    },
    "type": {
      "type": "string",
      "enum": [
        "certificate",
        "training",
        "induction",
        "ticket"
      ],
      "default": "certificate"
    },
    "issuer": {
      "type": "string",
      "description": "Training provider or certifying body"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded certificate / document URL"
    },
    "notes": {
      "type": "string"
    },
    "added_by": {
      "type": "string"
    }
  },
  "required": [
    "employee_email",
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "operations_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "data.employee_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "operations_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "data.employee_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "operations_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            },
            {
              "data.employee_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "operations_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    }
  }
}