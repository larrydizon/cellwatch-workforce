{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company / organization name"
    },
    "logo": {
      "type": "string",
      "description": "Public URL of the company logo shown throughout the signed-in app"
    },
    "description": {
      "type": "string",
      "description": "Short company description shown on the company settings card"
    },
    "brand_color": {
      "type": "string",
      "description": "Primary brand colour as a hex value, applied to buttons, links and highlights"
    },
    "brand_accent": {
      "type": "string",
      "description": "Secondary brand colour as a hex value, used for charts and secondary highlights"
    },
    "appearance": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "default": "dark",
      "description": "Light, dark, or device-matched appearance for the workspace"
    },
    "legal_name": {
      "type": "string",
      "description": "Registered legal / trading name when it differs from the display name"
    },
    "business_id": {
      "type": "string",
      "description": "Company or business registration number"
    },
    "industry": {
      "type": "string",
      "description": "Industry the company operates in"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone for the company e.g. Pacific/Auckland"
    },
    "address": {
      "type": "string",
      "description": "Company postal or physical address"
    },
    "phone": {
      "type": "string",
      "description": "Company contact phone number"
    },
    "email": {
      "type": "string",
      "description": "Company contact email address"
    },
    "website": {
      "type": "string",
      "description": "Company website address"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "enterprise"
      ],
      "default": "free"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "canceled"
      ],
      "default": "trial"
    },
    "seat_limit": {
      "type": "number",
      "default": 5,
      "description": "Max employees allowed on this plan"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time",
      "description": "End of the current paid billing period, kept in sync by Stripe"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false,
      "description": "True when the owner has cancelled but the paid period has not ended yet"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who owns this organization"
    },
    "member_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users belonging to this organization"
    },
    "pending_invites": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Invited employees and the profile details to apply when they join"
    },
    "settings": {
      "type": "object",
      "description": "Organization operational settings: capture_gps, overtime_alerts, email_notifications, daily_report_default, late_clockin_alerts, missed_clockout_alerts, tracking_interval_ms, presence_checks_enabled, presence_camera, presence_location, presence_device, presence_interval_ms"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.member_emails": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "workspace_service"
      }
    },
    "update": {
      "user_condition": {
        "role": "workspace_service"
      }
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}