{
  "name": "ProfileField",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this custom profile field belongs to"
    },
    "label": {
      "type": "string",
      "description": "Field label shown on employee profiles e.g. Bank Account Number"
    },
    "key": {
      "type": "string",
      "description": "Machine key used to store the value on the employee record"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "date",
        "select"
      ],
      "default": "text"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Choices for dropdown fields"
    },
    "admin_only": {
      "type": "boolean",
      "default": false,
      "description": "If true, only administrators can edit this value"
    }
  },
  "required": [
    "label",
    "key"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}