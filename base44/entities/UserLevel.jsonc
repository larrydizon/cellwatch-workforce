{
  "name": "UserLevel",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this user level belongs to"
    },
    "label": {
      "type": "string",
      "description": "Level name shown to admins e.g. Office Manager"
    },
    "value": {
      "type": "string",
      "description": "Machine value stored on the employee record"
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "description": "Grants administrator access to this level"
    }
  },
  "required": [
    "label",
    "value"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}