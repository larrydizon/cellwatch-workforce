{
  "name": "Notification",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this notification belongs to"
    },
    "recipient_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "shift_assigned",
        "shift_changed",
        "timesheet_rejected",
        "task_assigned",
        "announcement",
        "leave_approved",
        "leave_rejected",
        "general"
      ],
      "default": "general"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string",
      "description": "URL or route to navigate to"
    }
  },
  "required": [
    "recipient_email",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "data.recipient_email": "{{user.email}}" }
      ]
    },
    "create": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "$or": [
          { "data.recipient_email": "{{user.email}}" },
          { "user_condition": { "role": "admin" } },
          { "user_condition": { "role": "operations_manager" } },
          { "user_condition": { "role": "supervisor" } }
        ] }
      ]
    },
    "update": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "data.recipient_email": "{{user.email}}" }
      ]
    },
    "delete": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "$or": [
          { "data.recipient_email": "{{user.email}}" },
          { "user_condition": { "role": "admin" } }
        ] }
      ]
    }
  }
}
