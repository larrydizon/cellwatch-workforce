{
  "name": "FormTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this form template belongs to"
    },
    "title": {
      "type": "string",
      "description": "Form title e.g. Health & Safety Prestart"
    },
    "description": {
      "type": "string"
    },
    "form_type": {
      "type": "string",
      "enum": [
        "prestart",
        "health_safety",
        "incident",
        "hazard",
        "induction",
        "other"
      ],
      "default": "prestart"
    },
    "industry": {
      "type": "string",
      "description": "Target worker position/industry this form applies to. Empty = universal (all positions).",
      "enum": [
        "",
        "telecom",
        "roading",
        "steel_fixing",
        "construction",
        "electrical",
        "transport",
        "mining",
        "healthcare",
        "hospitality",
        "retail",
        "security",
        "office"
      ],
      "default": ""
    },
    "job_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Job categories (Job.job_type) that trigger this form before clock-in. Empty = required for any job."
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of question objects: {id, label, type, options, required}"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "require_before_clockin": {
      "type": "boolean",
      "default": false,
      "description": "If true, employees must complete this form before clocking in"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "every_clockin",
        "daily",
        "weekly"
      ],
      "default": "daily",
      "description": "How often the form needs to be completed"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "$or": [
          { "user_condition": { "role": "admin" } },
          { "user_condition": { "role": "operations_manager" } },
          { "user_condition": { "role": "supervisor" } }
        ] }
      ]
    },
    "update": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "$or": [
          { "user_condition": { "role": "admin" } },
          { "user_condition": { "role": "operations_manager" } },
          { "user_condition": { "role": "supervisor" } }
        ] }
      ]
    },
    "delete": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
