{
  "name": "FormAssignment",
  "type": "object",
  "properties": {
    "form_template_id": {
      "type": "string"
    },
    "form_title": {
      "type": "string"
    },
    "form_type": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Optional deadline for completion"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "overdue"
      ],
      "default": "pending"
    },
    "assigned_by": {
      "type": "string",
      "description": "Email of admin who assigned the form"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "form_submission_id": {
      "type": "string",
      "description": "Link to the FormSubmission created on completion"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "form_template_id",
    "employee_email",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "data.employee_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        },
        {
          "data.employee_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "supervisor"
          }
        }
      ]
    }
  }
}