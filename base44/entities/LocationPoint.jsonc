{
  "name": "LocationPoint",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this reading belongs to"
    },
    "employee_email": {
      "type": "string",
      "description": "Employee whose device produced the reading"
    },
    "employee_name": {
      "type": "string"
    },
    "time_entry_id": {
      "type": "string",
      "description": "Open time entry this reading was captured against"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "accuracy": {
      "type": "number",
      "description": "Reported GPS accuracy in metres"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the position was read from the device"
    }
  },
  "required": [
    "organization_id",
    "employee_email",
    "latitude",
    "longitude",
    "captured_at"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "$or": [
            {
              "data.employee_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "operations_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "location_service"
      }
    },
    "update": {
      "user_condition": {
        "role": "location_service"
      }
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}