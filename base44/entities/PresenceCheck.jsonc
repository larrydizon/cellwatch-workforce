{
  "name": "PresenceCheck",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Tenant (organization) this check belongs to"
    },
    "employee_email": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "time_entry_id": {
      "type": "string",
      "description": "Open time entry this check was captured against"
    },
    "check_type": {
      "type": "string",
      "enum": [
        "snapshot",
        "location",
        "missed"
      ],
      "default": "location",
      "description": "snapshot = camera image captured, location = position only, missed = nothing could be captured"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "accuracy": {
      "type": "number"
    },
    "device_id": {
      "type": "string",
      "description": "Stable token generated per browser on first use \u2014 not a hardware serial"
    },
    "device_label": {
      "type": "string",
      "description": "Readable platform and browser summary"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage reference for the snapshot image"
    },
    "note": {
      "type": "string",
      "description": "Why a check was missed, when applicable"
    }
  },
  "required": [
    "organization_id",
    "employee_email",
    "check_type",
    "captured_at"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "$or": [
            {
              "data.employee_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "operations_manager"
              }
            },
            {
              "user_condition": {
                "role": "supervisor"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "presence_service"
      }
    },
    "update": {
      "user_condition": {
        "role": "presence_service"
      }
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}