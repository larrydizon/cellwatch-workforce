{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "canceled"
      ],
      "default": "active"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "$and": [
        { "data.organization_id": "{{user.data.organization_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {
      "user_condition": { "role": "billing_service" }
    },
    "update": {
      "user_condition": { "role": "billing_service" }
    },
    "delete": {
      "user_condition": { "role": "billing_service" }
    }
  }
}
